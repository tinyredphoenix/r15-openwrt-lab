#!/bin/sh
# Pure IPv4 range check: no network, UCI, process, or filesystem mutations.
# Usage: r15-subnet-check learned-address/prefix protected-subnets-file
# 0 = disjoint; 1 = overlap; 2 = malformed/missing policy or lease.
[ "$#" -eq 2 ] && [ -r "$2" ] || exit 2
case "$1" in ''|*[!0-9./]*) exit 2 ;; esac
LC_ALL=C awk -v learned="$1" '
function range(value, parts, octets, n, i, address, size) {
    n=split(value,parts,"/")
    if (n!=2 || parts[2] !~ /^(0|[1-9][0-9]*)$/ || parts[2]>32) return 0
    if (split(parts[1],octets,".")!=4) return 0
    address=0
    for(i=1;i<=4;i++) {
        if(octets[i] !~ /^(0|[1-9][0-9]*)$/ || octets[i]>255) return 0
        address=address*256+octets[i]
    }
    size=2^(32-parts[2]); low=int(address/size)*size; high=low+size-1
    return 1
}
BEGIN {
    if(!range(learned)) invalid=1
    uplow=low; uphigh=high
}
{
    count++
    if(!range($0)) invalid=1
    else if(uplow<=high && low<=uphigh) overlap=1
}
END {
    # The renderer reserves exactly management and client subnets.
    if(invalid || count!=2) exit 2
    if(overlap) exit 1
    exit 0
}' "$2"
