#!/bin/sh /etc/rc.common
USE_PROCD=1
START=80
STOP=10
start_service() {
    config_load r15_radio
    config_get_bool enabled repeater enabled 0
    [ "$enabled" = 1 ] || return 0
    procd_open_instance paired
    procd_set_param command /usr/libexec/r15-radio-launch
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 30
    procd_set_param file /etc/config/r15_radio
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
service_triggers() {
    procd_add_reload_trigger r15_radio
}
