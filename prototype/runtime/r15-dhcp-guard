#!/bin/sh
# Validate udhcpc environment before OpenWrt publishes addresses/routes.
# No interface, route, file, process, or network mutation occurs here.
# Args: protected-subnets-file, subnet-check-script. 0 valid, 1 rejected.
[ "$#" -eq 2 ] && [ -r "$1" ] && [ -r "$2" ] || exit 1
POLICY=$1; CHECK=$2
set -f
ipv4() {
    case "$1" in ''|*[!0-9.]*|0.0.0.0|255.255.255.255) return 1 ;; esac
    printf '%s\n' "$1" | awk -F. '
        NF!=4 { bad=1 }
        { for(i=1;i<=NF;i++) if($i !~ /^(0|[1-9][0-9]*)$/ || $i>255) bad=1 }
        END { exit bad?1:0 }'
}
protected() { /bin/sh "$CHECK" "$1" "$POLICY"; }
ipv4 "${ip:-}" || exit 1
case "$ip" in 0.*|127.*|169.254.*|22[4-9].*|23[0-9].*|24[0-9].*|25[0-5].*) exit 1 ;; esac
case "${subnet:-}" in ''|*[!0-9.]*) exit 1 ;; esac
prefix=$(printf '%s\n' "$subnet" | awk -F. '
    NF!=4 { bad=1 }
    { m=0; for(i=1;i<=NF;i++) {
        if($i !~ /^(0|[1-9][0-9]*)$/ || $i>255) bad=1
        m=m*256+$i
    }}
    END {
        if(bad) exit 1
        for(p=0;p<=32;p++) if(m==2^32-2^(32-p)) { print p; exit }
        exit 1
    }') || exit 1
[ -z "${mask:-}" ] || [ "$mask" = "$prefix" ] || exit 1
protected "$ip/$prefix" || exit 1
for gateway in ${router:-}; do
    ipv4 "$gateway" && protected "$gateway/32" || exit 1
done
# Validate all classless route pairs. Default routes are allowed; non-default
# destinations and off-link gateway /32 routes must not consume local subnets.
validate_routes() {
    set -- $1
    while [ "$#" -gt 0 ]; do
        [ "$#" -ge 2 ] || return 1
        case "$1" in */*) ;; *) return 1 ;; esac
        target=${1%/*}; bits=${1##*/}
        # subnet-check supplies canonical CIDR validation even for default routes.
        /bin/sh "$CHECK" "$1" "$POLICY"
        rc=$?
        [ "$rc" -ne 2 ] || return 1
        if [ "$bits" = 0 ]; then
            [ "$target" = 0.0.0.0 ] || return 1
        else
            [ "$rc" -eq 0 ] || return 1
        fi
        ipv4 "$2" && protected "$2/32" || return 1
        shift 2
    done
}
validate_routes "${staticroutes:-}" || exit 1
validate_routes "${msstaticroutes:-}" || exit 1
# Locally configured extra routes require a separate review; the renderer
# does not emit any. Reject rather than passing unchecked data to stock logic.
[ -z "${CUSTOMROUTES:-}" ] || exit 1
exit 0
