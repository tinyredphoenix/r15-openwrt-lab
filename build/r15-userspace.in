# SDK metadata only: compile NAND userspace for the actual retained R15 kernel.
# This does not select or build the SDK's unrelated board kernel or image.
# Some SDKs omit unset hidden capabilities entirely from Config-build.in.
config NAND_SUPPORT
	bool

config R15_VENDOR_NAND
	bool "R15 retained-kernel NAND userspace"
	default y
	select NAND_SUPPORT
